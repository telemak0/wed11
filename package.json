{
  "name": "wed11",
  "version": "1.0.0",
  "description": "Amateur football lineup management and betting system on GitHub Pages",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "type-check": "tsc --noEmit",
    "bundle-report": "vite build --outDir dist-report && esbuild-visualizer dist-report/stats.json || true",
    "deploy": "npm run build && npm run test && git subtree push --prefix dist origin gh-pages"
  },
  "keywords": [
    "football",
    "lineup",
    "betting",
    "github-pages"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "firebase": "^10.7.0",
    "i18next": "^25.8.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^16.5.4",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.10.5",
    "@types/react": "^19.2.11",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^1.0.4",
    "autoprefixer": "^10.4.24",
    "eslint": "^8.56.0",
    "jsdom": "^23.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.1.1",
    "tailwindcss": "3.4",
    "terser": "^5.26.0",
    "typescript": "^5.3.3",
    "vi": "^1.0.0",
    "vite": "^5.0.7",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
